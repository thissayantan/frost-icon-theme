      "anyOf": [
        {
          "type": "string",
          "minLength": 3
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "light",
            "deep"
          ],
          "properties": {
            "light": {
              "type": "string"
            },
            "deep": {
